Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: NSOFT Payroll Module
Bundle-SymbolicName: org.nsoft.idempiere.payroll;singleton:=true
Bundle-Version: 1.0.0.qualifier
