Bundle-Activator: org.nsoft.idempiere.payroll.Activator
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Bundle: org.adempiere.base;bundle-version="13.0.0",
 org.adempiere.hr;bundle-version="13.0.0";resolution:=optional
Import-Package: org.osgi.framework;version="1.3.0"
Export-Package: org.nsoft.idempiere.payroll.model.run,
 org.nsoft.idempiere.payroll.model.bpjs,
 org.nsoft.idempiere.payroll.model.tax,
 org.nsoft.idempiere.payroll.model.component,
 org.nsoft.idempiere.payroll.model.contract,
 org.nsoft.idempiere.payroll.process,
 org.nsoft.idempiere.payroll.calc 
 
