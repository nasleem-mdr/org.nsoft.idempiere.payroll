Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: NSOFT Payroll Module
Bundle-SymbolicName: org.nsoft.idempiere.payroll;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Vendor: NSOFT
Bundle-Activator: org.nsoft.idempiere.payroll.Activator
Bundle-RequiredExecutionEnvironment: JavaSE-11

Require-Bundle: org.adempiere.base;bundle-version="2.0.0",
 org.compiere.model;bundle-version="2.0.0",
 org.adempiere.hr;bundle-version="2.0.0";resolution:=optional

Import-Package: org.osgi.framework;version="1.3.0"

Export-Package: org.nsoft.idempiere.payroll.model.run,
 org.nsoft.idempiere.payroll.model.bpjs,
 org.nsoft.idempiere.payroll.model.tax,
 org.nsoft.idempiere.payroll.model.component,
 org.nsoft.idempiere.payroll.process,
 org.nsoft.idempiere.payroll.calc

Service-Component: OSGI-INF/model-validator-factory.xml
